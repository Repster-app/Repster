  "program_bridge": {
    "query": "WITH newcomers AS (\n    SELECT person_id,\n        min(timestamp) AS first_onboarding,\n        argMin(properties.$app_version, timestamp) AS entry_version,\n        argMin(properties.step, timestamp) AS entry_step\n    FROM events\n    WHERE event = 'onboarding step viewed'\n        AND timestamp < '2026-09-20'\n        AND coalesce(person.properties.internal_team, false) != true\n        AND coalesce(properties.$is_emulator, false) != true\n        AND coalesce(properties.$is_testflight, false) != true\n    GROUP BY person_id\n    HAVING first_onboarding >= '2026-09-07'\n        AND entry_version = '1.5'\n        AND entry_step = 'welcome'\n), activity AS (\n    SELECT person_id,\n        countIf(event = 'workout started') AS starts,\n        countIf(event = 'first set logged') AS first_sets,\n        countIf(event = 'program selected' AND properties.program_id != 'own') AS chose_program,\n        countIf(event = '$screen' AND properties.$screen_name = 'Templates') AS template_views,\n        countIf(event = 'template started') AS template_starts,\n        countIf(event = 'workout started' AND properties.source != 'empty') AS nonempty_source_starts,\n        countIf(event = 'onboarding completed') AS onboarding_completions\n    FROM events\n    WHERE timestamp >= '2026-09-07' AND timestamp < '2026-09-20'\n        AND coalesce(person.properties.internal_team, false) != true\n        AND coalesce(properties.$is_emulator, false) != true\n        AND coalesce(properties.$is_testflight, false) != true\n    GROUP BY person_id\n)\nSELECT count() AS newcomers,\n    countIf(a.chose_program > 0) AS picked_program,\n    countIf(a.chose_program > 0 AND a.starts > 0) AS picked_program_and_started,\n    countIf(a.chose_program > 0 AND a.template_views > 0) AS picked_program_and_viewed_templates,\n    countIf(a.chose_program > 0 AND a.template_starts > 0) AS picked_program_and_started_template,\n    countIf(a.starts > 0) AS started_any_workout,\n    countIf(a.starts > 0 AND a.nonempty_source_starts = 0) AS starters_only_empty_source,\n    countIf(a.starts > 0 AND a.first_sets = 0) AS started_but_no_first_set,\n    countIf(a.starts > 0 AND a.onboarding_completions = 0) AS started_without_onboarding_completion\nFROM newcomers n\nJOIN activity a ON n.person_id = a.person_id",
